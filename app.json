{
  "expo": {
    "name": "Movies",
    "slug": "collars-movies",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFD000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jsburbano.movies",
      "icon": "./assets/icon.png",
      "backgroundColor": "#FFD000",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFD000"
      },
      "package": "com.jsburbano.movies"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "collars-movies",
    "extra": {
      "eas": {
        "projectId": "cb79eeed-72be-4678-a894-6ec316b297eb"
      }
    }
  }
}
