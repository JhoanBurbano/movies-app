{
  "expo": {
    "name": "Collars Movies",
    "slug": "collars-movies",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFD000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.collars.movies"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFD000"
      },
      "package": "com.collars.movies"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "collars-movies"
  }
}

