{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "apk"
      },
      "ios": {}
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6756561531"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6756561531"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}

